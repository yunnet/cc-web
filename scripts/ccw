#!/usr/bin/env bash
#
# ccw — start / stop / restart / status for cc-web on this box. Ports only,
# no named instances: the old scripts/ccweb.sh, the stable/dev names, all
# folded into this one script and then simplified away.
#
#   ccw status  [<port>]   pid, uptime, version, data dir, health
#   ccw start   [<port>]   no port = 32352, the project's one instance
#   ccw stop    [<port>]
#   ccw restart [<port>]
#   ccw logs    [<port>]   tail the instance's log
#   ccw token   [<port>]   print the token (made if missing)
#
# Every port — 32352 included — runs THIS checkout with token-<port>,
# data-<port> and <port>.log under ~/.cc-web. The port is a number; anything
# else (`-d`, `dev`, `stable`…) is refused here, not passed to the server to
# die on. One project, one server: tests take another port (user 2026-11-16:
# 「对于一个项目来说，只需要启动一个，至于要测试，可以手工指定端口」).
#
# Env, settable on the command line or in ~/.cc-web/ccw.conf (also sourced:
# ccweb.env, the old script's conf, read first so ccw.conf wins):
#   CCWEB_REMOTE=1         run the remote host's copy of this script over ssh
#   CCWEB_SSH              user@host for CCWEB_REMOTE=1
#   CCWEB_REMOTE_SCRIPT    path of this script on that host
#   CCWEB_AUTH=xxx         write/rotate the token before starting
#   CCWEB_AUTH_FILE        token path for bare ports only (local, never remote)
#   CCWEB_PLANS_DIR        --plans-dir (default <checkout>/../.claude/plans)
#   CCW_LOG_DIR            where the logs go (default ~/.cc-web)
#
# Linux and macOS. Under Git Bash / MSYS on Windows it hands over to ccw.ps1,
# which takes the same commands.
#
# Four traps this exists to keep you out of:
#
#   1. `pkill -f "port 32352"` matches the shell that ran it. Killing an
#      instance that way takes your own terminal with it (seen: exit 144). This
#      finds the LISTENER on the port (`ss` on Linux, `lsof` on macOS) and
#      signals that pid, nothing else.
#   2. Two instances must never share a data directory ("Two servers sharing a
#      data directory read/write each other's sessions"). Every port gets
#      data-<port> — derived, never inherited: a Claude running inside an
#      instance exports CCW_DATA_DIR, and a port started from there must not
#      silently adopt it. 32352's real sessions live in data-32352; the empty
#      `data` fork it briefly started on (2026-11-16, 0 sessions) was deleted.
#   3. Restarting the instance from a Claude session that RUNS inside it
#      kills the shell doing the restarting, half way through. When that is
#      detected the work is handed to a detached session (setsid; perl's
#      POSIX::setsid on macOS, which has no setsid(1)) so it finishes after
#      this process is gone.
#   4. A non-numeric argument is refused up front. The old ccweb.sh took any
#      $1 as the port, so `ccweb.sh -d` reached the server as `--port -d`,
#      died instantly, and the script still waited 15s to report "not
#      responding" (seen twice on this box: token--d, -d.log).

set -uo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
SELF_DIR=$(cd "$SCRIPT_DIR/.." && pwd)    # the checkout this script came from

case "$(uname -s)" in
  MINGW*|MSYS|CYGWIN*)
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass \
      -File "$(cygpath -w "$SCRIPT_DIR/ccw.ps1")" "$@" ;;
esac

# --- local deployment ---------------------------------------------------------
# Machine-specific knobs (CCWEB_PLANS_DIR, CCW_LOG_DIR, …) live in
# ~/.cc-web/ccw.conf — or the older ccweb.env — both sourced below. Tokens,
# logs and data all live under ~/.cc-web, the layout src/utils/data-dir.js
# resolves: token-<port>, data-<port>, <port>.log per instance.

CCW_HOME=$HOME/.cc-web
DEFAULT_PORT=32352    # `ccw start` with no port: the project's one instance

LOG_DIR=${CCW_LOG_DIR:-$CCW_HOME}
STOP_TIMEOUT=15       # seconds to wait for a clean exit before SIGKILL
START_TIMEOUT=25      # seconds to wait for the port to answer

# shellcheck source=/dev/null
[ -f "${CCWEB_CONF:-$CCW_HOME/ccweb.env}" ] && . "${CCWEB_CONF:-$CCW_HOME/ccweb.env}"
[ -f "$CCW_HOME/ccw.conf" ] && . "$CCW_HOME/ccw.conf"

# node is a mise shim, which only an interactive shell has on PATH; without
# this the nohup start dies with "node: No such file or directory" (launchd,
# another tool's shell).
command -v node >/dev/null 2>&1 || PATH="$HOME/.local/share/mise/shims:$PATH"

# Run the remote host's copy instead (CCWEB_REMOTE=1). Everything after this
# line is local-only. CCWEB_AUTH_FILE writes a local file — never send it over
# ssh. (Plain echo+exit: die() is defined later, this block runs before it.)
if [ "${CCWEB_REMOTE:-}" = "1" ]; then
  { [ -n "${CCWEB_SSH:-}" ] && [ -n "${CCWEB_REMOTE_SCRIPT:-}" ]; } || {
    echo "CCWEB_REMOTE=1 needs CCWEB_SSH and CCWEB_REMOTE_SCRIPT (set them in $CCW_HOME/ccw.conf)" >&2; exit 1; }
  [ -z "${CCWEB_AUTH_FILE:-}" ] || { echo "CCWEB_AUTH_FILE is local-only; use CCWEB_AUTH=..." >&2; exit 1; }
  exec ssh "$CCWEB_SSH" "CCWEB_AUTH='${CCWEB_AUTH:-}' '$CCWEB_REMOTE_SCRIPT' $*"
fi

# --- plumbing -----------------------------------------------------------------

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_yel=$'\033[33m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s✓%s %s\n' "$c_grn" "$c_off" "$*"; }
warn() { printf '%s!%s %s\n' "$c_yel" "$c_off" "$*"; }
die()  { printf '%s✗%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

# Resolve a port to its settings. Sets the cfg_* globals.
load() {
  case "$1" in
    *[!0-9]*|'') die "unknown instance '$1'（用法: ccw <命令> [端口号]，默认 ${DEFAULT_PORT}）" ;;
    *)            # token-<port>, data-<port>, <port>.log under ~/.cc-web, this
                  # checkout as the tree. data-<port> is derived, never read
                  # from the inherited CCW_DATA_DIR (trap 2 above).
                  cfg_name=$1; cfg_port=$1; cfg_dir=$SELF_DIR
                  cfg_auth=${CCWEB_AUTH_FILE:-$CCW_HOME/token-$1}
                  cfg_plans=${CCWEB_PLANS_DIR:-$(dirname "$SELF_DIR")/.claude/plans}
                  cfg_data=$CCW_HOME/data-$1
                  cfg_log="$LOG_DIR/$1.log" ;;
  esac
}

# The pid LISTENING on a port — never a pattern match against a command line,
# which is what makes `pkill -f` eat the caller.
pid_on_port() {
  if command -v ss >/dev/null 2>&1; then
    ss -lptnH "sport = :$1" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2
  else
    lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | head -1
  fi
}

# /proc is Linux-only; macOS answers the same questions through ps and lsof.
ppid_of() {
  if [ -r "/proc/$1/status" ]; then
    awk '/^PPid:/{print $2}' "/proc/$1/status" 2>/dev/null
  else
    ps -o ppid= -p "$1" 2>/dev/null | tr -d ' '
  fi
}

cwd_of() {
  if [ -e "/proc/$1/cwd" ]; then
    readlink "/proc/$1/cwd" 2>/dev/null
  else
    lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1
  fi
}

# A variable from a running process's environment (own processes only).
env_of() {
  if [ -r "/proc/$1/environ" ]; then
    tr '\0' '\n' < "/proc/$1/environ" 2>/dev/null | sed -n "s/^$2=//p"
  else
    ps eww -o command= -p "$1" 2>/dev/null | tr ' ' '\n' | sed -n "s/^$2=//p" | head -1
  fi
}

# Is `pid` an ancestor of this script? (i.e. would killing it kill us)
is_ancestor() {
  local target=$1 p=$$
  while [ -n "$p" ] && [ "$p" != "1" ] && [ "$p" != "0" ]; do
    [ "$p" = "$target" ] && return 0
    p=$(ppid_of "$p")
  done
  return 1
}

# Run a shell command in a new session, out of reach of whatever kills ours.
detach() {
  if command -v setsid >/dev/null 2>&1; then
    setsid bash -c "$1" &
  elif command -v perl >/dev/null 2>&1; then
    perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' bash -c "$1" &
  else
    nohup bash -c "$1" &
  fi
}

port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

# /api/health with the instance's own token: proves the server is up AND
# serving with the auth we just wrote, not merely that the port is bound.
health_ok() {
  [ -n "$(curl -s -m 2 -H "Authorization: Bearer $(head -n1 "$cfg_auth" 2>/dev/null)" \
    "http://127.0.0.1:$cfg_port/api/health" 2>/dev/null)" ]
}

# Reap the claude hook relays a dead server leaves behind. The pattern carries
# the closing quote of claude-bridge's injected command ('<…>/bin/cc-hook.js'
# --port N), so it cannot match this script's own command line.
reap_hooks() { pkill -f "cc-hook.js' --port $cfg_port" 2>/dev/null || true; }

# --- commands -----------------------------------------------------------------

do_status() {
  load "$1"
  local pid; pid=$(pid_on_port "$cfg_port")
  local version; version=$(node -e "try{process.stdout.write(require('$cfg_dir/package.json').version)}catch(e){process.stdout.write('?')}" 2>/dev/null)

  printf '%s%-7s%s :%s\n' "$c_dim" "$cfg_name" "$c_off" "$cfg_port"
  if [ -z "$pid" ]; then
    printf '  %s停止%s   磁盘代码 v%s  %s\n' "$c_red" "$c_off" "$version" "$cfg_dir"
    return
  fi
  local started; started=$(ps -o lstart= -p "$pid" 2>/dev/null | sed 's/^ *//')
  local uptime;  uptime=$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')
  local rundir;  rundir=$(cwd_of "$pid")
  local data;    data=$(env_of "$pid" CCW_DATA_DIR)
  local kids;    kids=$(pgrep -P "$pid" 2>/dev/null | wc -l)
  local health;  health=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "http://localhost:$cfg_port/" 2>/dev/null)

  printf '  %s运行中%s pid=%s  已跑 %s  HTTP %s  claude 子进程 %s\n' "$c_grn" "$c_off" "$pid" "$uptime" "$health" "$kids"
  printf '  磁盘代码 v%s   %s\n' "$version" "$cfg_dir"
  [ -n "$rundir" ] && [ "$rundir" != "$cfg_dir" ] && warn "  运行目录与配置不符: $rundir"
  printf '  数据目录 %s\n' "${data:-$CCW_HOME/data (默认)}"
  printf '  启动于 %s\n' "$started"
  # The version on disk is not the version running: the process loaded its code
  # at startup. Frontend files are read per request, so they ARE live.
  printf '  %s注意：磁盘上的版本不等于运行中的版本——服务端改动要重启才生效%s\n' "$c_dim" "$c_off"
}

# Prepare ~/.cc-web and the port's token: a missing token is generated
# (umask 077), an existing one is left as is. Printed as one line so
# `ccw restart` can hand it to the detached shell alongside start_cmd.
adopt_cmd() {
  printf 'mkdir -p %q && chmod 700 %q' "$CCW_HOME" "$CCW_HOME"
  printf "; { [ -s %q ] || ( umask 077; node -e \"process.stdout.write(require('crypto').randomBytes(24).toString('hex'))\" > %q ); }" \
    "$cfg_auth" "$cfg_auth"
}

start_cmd() {
  # Printed as one line so `ccw restart` can hand it to a detached shell.
  # The env assignment has to sit on the `node` command, NOT in front of `cd`.
  # `CCW_DATA_DIR=x cd dir && node …` applies the variable to `cd` and the
  # server starts without it — which is exactly the "two servers sharing a data
  # directory" refusal this script exists to prevent. Caught by testing it.
  # Always assigned: a Claude running inside an instance inherits its
  # CCW_DATA_DIR, and another one started from there must not.
  local data_env
  data_env="CCW_DATA_DIR=$(printf '%q' "$cfg_data") "
  printf 'cd %q && %snohup node bin/cc-web.js --no-open --port %s --auth-file %q --plans-dir %q >> %q 2>&1 &' \
    "$cfg_dir" "$data_env" "$cfg_port" "$cfg_auth" "$cfg_plans" "$cfg_log"
}

do_start() {
  load "$1"
  local pid; pid=$(pid_on_port "$cfg_port")
  if [ -n "$pid" ]; then ok "$cfg_name 已经在跑 (pid=$pid)"; return 0; fi
  [ -d "$cfg_dir" ] || die "$cfg_name 的目录不存在: $cfg_dir"
  mkdir -p "$LOG_DIR"

  # CCWEB_AUTH=xxx rotates the token before this start; without it an existing
  # token file is adopted as is (adopt_cmd never overwrites).
  if [ -n "${CCWEB_AUTH:-}" ]; then
    ( umask 077; printf '%s\n' "$CCWEB_AUTH" > "$cfg_auth" )
  fi

  eval "$(adopt_cmd)"
  eval "$(start_cmd)"
  local waited=0
  while [ "$waited" -lt "$START_TIMEOUT" ]; do
    if port_open "$cfg_port" && health_ok; then
      ok "$cfg_name 已启动 (pid=$(pid_on_port "$cfg_port"))  端口 $cfg_port"
      return 0
    fi
    sleep 1; waited=$((waited + 1))
  done
  warn "$cfg_name 起了但 ${START_TIMEOUT}s 内没就绪，看日志: $cfg_log"
  tail -5 "$cfg_log" 2>/dev/null
  return 1
}

do_stop() {
  load "$1"
  local pid; pid=$(pid_on_port "$cfg_port")
  if [ -z "$pid" ]; then ok "$cfg_name 本来就没在跑"; return 0; fi

  if is_ancestor "$pid"; then
    warn "$cfg_name (pid=$pid) 是当前进程的祖先——停掉它会一并杀掉你正在用的会话"
    warn "这一步交给脱离出去的 shell 执行，本进程随后会被终止"
    detach "kill $pid; sleep 2; pkill -f \"cc-hook.js' --port $cfg_port\" 2>/dev/null" >/dev/null 2>&1 < /dev/null
    return 0
  fi

  kill "$pid" 2>/dev/null
  local waited=0
  while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt "$STOP_TIMEOUT" ]; do
    sleep 1; waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    warn "$cfg_name ${STOP_TIMEOUT}s 内没退出，改用 SIGKILL"
    kill -9 "$pid" 2>/dev/null; sleep 1
  fi
  reap_hooks
  ok "$cfg_name 已停止"
}

do_restart() {
  load "$1"
  local pid; pid=$(pid_on_port "$cfg_port")
  mkdir -p "$LOG_DIR"

  # Restarting the instance we are running inside: the kill lands on our own
  # ancestor, so everything after it in this shell would never execute. Hand the
  # whole sequence to a detached session and get out of the way.
  if [ -n "$pid" ] && is_ancestor "$pid"; then
    warn "你正在 $cfg_name (pid=$pid) 里面——重启会杀掉当前会话"
    say  "已交给后台执行：停止 → 等端口释放 → 启动。会话会按原 id --resume 恢复。"
    detach "
      kill $pid 2>/dev/null
      for i in \$(seq 1 $STOP_TIMEOUT); do kill -0 $pid 2>/dev/null || break; sleep 1; done
      kill -0 $pid 2>/dev/null && kill -9 $pid 2>/dev/null
      sleep 2
      pkill -f \"cc-hook.js' --port $cfg_port\" 2>/dev/null
      $(adopt_cmd)
      $(start_cmd)
    " >> "$cfg_log" 2>&1 < /dev/null
    return 0
  fi

  do_stop "$1"
  sleep 1
  do_start "$1"
}

do_logs() {
  load "$1"
  [ -f "$cfg_log" ] || die "还没有日志: $cfg_log"
  tail -f "$cfg_log"
}

do_token() {
  load "$1"
  eval "$(adopt_cmd)"
  head -1 "$cfg_auth"
}

# --- dispatch -----------------------------------------------------------------

cmd=${1:-status}
port=${2:-$DEFAULT_PORT}

case "$cmd" in
  status)  do_status  "$port" ;;
  start)   do_start   "$port" ;;
  stop)    do_stop    "$port" ;;
  restart) do_restart "$port" ;;
  logs)    do_logs    "$port" ;;
  token)   do_token   "$port" ;;
  -h|--help|help)
    awk 'NR>2 && /^#/{sub(/^# ?/,""); print; next} NR>2{exit}' "$0" ;;
  *) die "未知命令 '$cmd'（可用: status | start | stop | restart | logs | token）" ;;
esac
